APP_NAME=sampling_api
APP_ENV=development
APP_PORT=3030
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sampling
DB_USERNAME=root
DB_PASSWORD=

MAIL_FROM_EMAIL="kenny@qutebox.com"
MAIL_FROM_NAME=Kenny

# mailersend | resend | sendgrid
MAIL_DRIVER=mailersend
MAILERSEND_API_TOKEN=
RESEND_API_KEY=

# aws | none
SMS_DRIVER=aws
# sqs | cron (cron: schedule GET /v1/utils/run-cron-queue every minute)
QUEUE_DRIVER=sqs
# require OTP code when saving phone number (keep in sync with public PHONE_OTP_REQUIRED)
PHONE_OTP_REQUIRED=true

JWT_SECRET="secret_key"
# in seconds
JWT_ACCESS_EXPIRY=86400
JWT_REFRESH_EXPIRY=604800

UPLOAD_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_SQS_URL=
# S3-compatible storage (e.g. MinIO); leave empty for AWS S3
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# public base url incl. bucket, e.g. https://files.samplingreview.com/samplingreview
AWS_URL=

TWILIO_ACCOUNT_SID=
TWILIO_VERIFY_SID=
TWILIO_TOKEN=

WHATSAPP_NUMBER_ID=
WHATSAPP_TOKEN=

WEB_URL=http://localhost:3000

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evo-o2oengage.chattalyst.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=chattalyst
